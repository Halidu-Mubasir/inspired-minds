# Copy to .env for `docker compose up`. Never commit the real .env.

# Required. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DB_PASSWORD=

# Optional (defaults shown in docker-compose.yml)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Inspired Minds <no-reply@localhost>

# Optional. AI tutor and teacher tools stay switched off until this is set.
ANTHROPIC_API_KEY=
